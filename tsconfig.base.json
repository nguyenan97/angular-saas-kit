{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022", "dom"],
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@angular-saas-kit/ui": ["./libs/ui/src/index.ts"],
      "@angular-saas-kit/tokens": ["./libs/tokens/src/index.ts"],
      "@angular-saas-kit/mock-api": ["./libs/mock-api/src/index.ts"],
      "@angular-saas-kit/shared-kernel": ["./libs/shared/kernel/src/index.ts"],
      "@angular-saas-kit/booking-domain": [
        "./libs/booking/domain/src/index.ts"
      ],
      "@angular-saas-kit/booking-contracts": [
        "./libs/booking/contracts/src/index.ts"
      ],
      "@angular-saas-kit/booking-data-access": [
        "./libs/booking/data-access/src/index.ts"
      ],
      "@angular-saas-kit/booking-data-access/mock": [
        "./libs/booking/data-access/src/mock.ts"
      ],
      "@angular-saas-kit/booking-feature-orders": [
        "./libs/booking/feature-orders/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true
  },
  "exclude": ["node_modules", "tmp"]
}
