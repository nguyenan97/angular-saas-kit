{
  "name": "angular-saas-kit",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve dashboard",
    "start:landing": "nx serve landing",
    "build": "nx run-many -t build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "pages": "nx run-many -t build -p landing dashboard -c pages && nx run ui:build-storybook && npm run docs:build && node scripts/assemble-pages.mjs",
    "pages:preview": "node scripts/preview-pages.mjs",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "format:check": "prettier --check .",
    "verify": "nx run-many -t lint test build && npm run typecheck && npm run check:architecture && npm run check:packages",
    "prepare": "husky",
    "storybook": "nx run ui:storybook"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.8.0",
    "@analogjs/vitest-angular": "~2.8.0",
    "@angular-devkit/build-angular": "~22.2.1",
    "@angular-devkit/core": "~22.2.2",
    "@angular-devkit/schematics": "~22.2.2",
    "@angular/build": "~22.2.1",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.2",
    "@angular/language-service": "~22.2.2",
    "@angular/platform-browser-dynamic": "~22.2.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "^23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "^23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@oxc-project/runtime": "^0.154.0",
    "@playwright/test": "^1.64.0",
    "@schematics/angular": "~22.2.1",
    "@storybook/addon-a11y": "~10.6.2",
    "@storybook/angular": "~10.6.2",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.18",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/utils": "^8.71.2",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-environment-node": "~30.5.1",
    "jest-util": "~30.5.1",
    "jsdom": "^30.1.2",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.5.1",
    "mermaid": "^12.2.0",
    "ng-packagr": "~22.2.4",
    "nx": "23.3.0",
    "postcss": "^8.5.30",
    "prettier": "~3.9.10",
    "storybook": "~10.6.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.2",
    "@angular/common": "~22.2.2",
    "@angular/compiler": "~22.2.2",
    "@angular/core": "~22.2.2",
    "@angular/forms": "~22.2.2",
    "@angular/platform-browser": "~22.2.2",
    "@angular/platform-server": "~22.2.2",
    "@angular/router": "~22.2.2",
    "@angular/ssr": "~22.2.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide": "^1.57.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0"
  },
  "nx": {
    "includedScripts": []
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "nx@23.2.0": true,
    "unrs-resolver@1.12.2": true
  },
  "description": "Free Angular 22 admin dashboard and landing page. Zoneless, signals-first, Tailwind v4.",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "lint-staged": {
    "*.{ts,mts,vue,html,css,json,md,mjs,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "smol-toml": "^1.7.1",
    "axios": "^1.20.0",
    "nx": {
      "brace-expansion": "^5.0.12"
    },
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "^7.4.6"
    }
  }
}
